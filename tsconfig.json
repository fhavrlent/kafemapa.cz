{
  // Jen kontrola typů JavaScriptu (npm run typecheck), nic se nekompiluje: prohlížeč dostává
  // soubory z assets/ tak, jak jsou. Typy se píšou v JSDoc komentářích.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node", "leaflet", "leaflet.markercluster"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["assets/*.js", "scripts/*.mjs", "assets/types.d.ts", "assets/config.d.ts"],
  "exclude": ["assets/vendor", "assets/config.js"]
}
