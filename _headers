/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://api.mapy.com https://tile.openstreetmap.org; connect-src 'self' https://cloudflareinsights.com https://api.openstreetmap.org; manifest-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

/assets/vendor/*
  Cache-Control: public, max-age=604800

/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/indexnow-manifest.json
  Cache-Control: no-store

/status.json
  Cache-Control: no-store

/assets/fonts/*
  Cache-Control: public, max-age=2592000
